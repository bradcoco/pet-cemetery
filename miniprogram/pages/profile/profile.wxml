<view wx:if="{{visitorPreview}}" class="visitor-preview-banner"><view><view>👀 正在预览普通访客视角</view><text>只展示公开内容，私密资料和库存不展示</text></view><button bindtap="exitPreview">退出预览</button></view><view wx:if="{{visitorPreview}}" class="visitor-preview-spacer"></view>
<view wx:if="{{loading && !profile}}" class="page"><view class="empty">正在敲开这位守护者的家门…</view></view>
<view wx:elif="{{error}}" class="page"><view class="empty"><view>{{error}}</view><button class="primary" bindtap="load">重新看看</button></view></view>
<view wx:elif="{{profile}}" class="profile-page">
  <view class="profile-hero"><view class="eyebrow">A HOME FULL OF LITTLE LOVES</view><view class="guardian-avatar"><image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" /><text wx:else>✧</text></view><view class="guardian-name serif">{{profile.nickName}}的小小宇宙</view><view class="guardian-description">有些伙伴陪在身边，有些变成了星星。<br/>每一份爱，都有自己的位置。</view><view class="profile-stats"><view><text>{{living.length}}</text><view>身边的小伙伴</view></view><view><text>{{memories.length}}</text><view>心里的小星星</view></view></view><view class="profile-top-actions"><button wx:if="{{isOwner && !visitorPreview}}" class="profile-privacy-settings" bindtap="privacySettings">⚙ 隐私设置</button><button wx:if="{{isOwner}}" bindtap="create">＋ 登记小伙伴</button><button wx:if="{{isOwner && isCloud && !native}}" open-type="share">分享我的主页 ↗</button></view></view>
  <view class="profile-content"><view wx:if="{{publicGarden}}" class="public-garden-section"><view class="section-eyebrow">WELCOME TO OUR BACKYARD</view><view class="section-title serif">公开家园 <text>一起晒晒太阳</text></view><backyard id="public-backyard" read-only="{{true}}" public-garden="{{publicGarden}}" visitor-preview="{{visitorPreview}}"/></view><inventory wx:if="{{isOwner}}" wallet="{{wallet}}" loading="{{claiming}}" bindclaim="claim" /><view wx:if="{{isOwner}}" class="owner-note">你可以看到自己的私密档案；访客只会看到设为公开的伙伴。物品库存仅你自己可见。</view>
    <guestbook id="public-guestbook" user="{{profile.id}}" visitor-preview="{{visitorPreview}}"/>
    <view class="pet-section"><view class="section-eyebrow">LITTLE FRIENDS, BIG HAPPINESS</view><view class="section-title serif">正在好好长大的它们 <text>{{living.length}}</text></view><view wx:if="{{!living.length}}" class="section-empty">这里还没有公开的小伙伴档案。</view><view wx:for="{{living}}" wx:key="id" class="pet-card"><view class="pet-card-top"><view class="pet-avatar" data-id="{{item.id}}" bindtap="open"><pet-avatar src="{{item.photoUrls[0] || item.photos[0] || ''}}" emoji="{{item.avatarEmoji}}" species="{{item.species}}"/></view><view class="pet-information"><view class="pet-name serif" data-id="{{item.id}}" bindtap="open">{{item.name}}<text>陪伴中</text></view><view class="pet-no">{{item.demo ? '示例伙伴' : item.no ? 'No. ' + item.no : '专属宠物档案'}}</view><view class="pet-species">{{item.breed || item.species}} <text wx:if="{{item.privacy === 'private'}}">· ☽ 仅自己</text></view></view><text class="pet-symbol">✧</text></view><view class="pet-intro">{{item.epitaph || '很高兴认识你，今天也要快乐呀。'}}</view><view class="received-gifts"><text wx:for="{{item.receivedGifts}}" wx:for-item="gift" wx:key="id">{{gift.icon}} {{gift.count}}</text><text class="received-label">{{item.receivedValue}} 积分的心意</text></view><view class="pet-card-actions"><button wx:if="{{item.notebookEnabled !== false && (isOwner || item.notebookPrivacy === 'public')}}" class="pet-action secondary" data-id="{{item.id}}" bindtap="notes">{{item.notebookPrivacy === 'public' ? '公开笔记' : '🔒 私密笔记'}}</button><button wx:if="{{isOwner}}" class="pet-action secondary" data-id="{{item.id}}" bindtap="edit">编辑档案</button><button wx:else class="pet-action secondary" data-id="{{item.id}}" bindtap="open">认识它</button><button class="pet-action primary" data-id="{{item.id}}" bindtap="gift">送一份喜欢 ♡</button></view></view></view>
    <view class="pet-section"><view class="section-eyebrow">ALWAYS LOVED, ALWAYS HERE</view><view class="section-title serif">在星星上想念的它们 <text>{{memories.length}}</text></view><view wx:if="{{!memories.length}}" class="section-empty">愿每一份陪伴，都能长长久久。</view><view wx:for="{{memories}}" wx:key="id" class="pet-card memory-card"><view class="pet-card-top"><view class="pet-avatar" data-id="{{item.id}}" bindtap="open"><pet-avatar src="{{item.photoUrls[0] || item.photos[0] || ''}}" emoji="{{item.avatarEmoji}}" species="{{item.species}}"/></view><view class="pet-information"><view class="pet-name serif">{{item.name}}<text>永远珍藏</text></view><view class="pet-no">{{item.demo ? '示例伙伴' : item.no ? 'No. ' + item.no : '专属宠物档案'}}</view><view class="pet-species">{{item.breed || item.species}} · {{item.departed}}</view></view><text class="pet-symbol">☽</text></view><view class="pet-intro">{{item.epitaph || '谢谢你，来过我的世界。'}}</view><view class="received-gifts"><text wx:for="{{item.receivedGifts}}" wx:for-item="gift" wx:key="id">{{gift.icon}} {{gift.count}}</text><text class="received-label">{{item.receivedValue}} 积分的心意</text></view><view class="pet-card-actions"><button wx:if="{{item.notebookEnabled !== false && (isOwner || item.notebookPrivacy === 'public')}}" class="pet-action secondary" data-id="{{item.id}}" bindtap="notes">{{item.notebookPrivacy === 'public' ? '公开笔记' : '🔒 私密笔记'}}</button><button class="pet-action secondary" data-id="{{item.id}}" bindtap="open">{{item.hasMemorial === false ? '翻看它的回忆' : '去看望它'}}</button><button wx:if="{{item.hasMemorial !== false}}" class="pet-action primary" data-id="{{item.id}}" bindtap="gift">❀ 献一朵花 · {{item.flowers}}</button><button wx:elif="{{isOwner}}" class="pet-action primary" data-id="{{item.id}}" bindtap="edit">为它设立纪念</button></view></view></view>
    <view class="profile-footer serif">喜欢与想念，都可以被温柔接住。<text>✧ STELLAR PAWS</text></view>
  </view>
</view>
<gift-box wx:if="{{giftPet}}" pet="{{giftPet}}" bindclose="closeGift" bindgifted="gifted" bindwalletchange="walletChange" />
