<view class="page archives-page">
  <view class="archive-heading"><view><view class="eyebrow">MY LITTLE WORLD</view><view class="page-title">我的主页</view><view class="page-description">一起照顾家园，珍藏每一位伙伴的故事。</view></view><view class="archive-symbol">▤<text>♡</text></view></view>
  <view class="profile row"><view class="avatar"><image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill"/><text wx:else>✦</text></view><view class="profile-text"><view>{{profile.nickName}}</view><text>{{records.length}} 位小伙伴的收藏室</text></view><button class="edit-profile" bindtap="editProfile">{{editing ? '取消' : '编辑资料'}} ↗</button></view>
  <view wx:if="{{editing}}" class="profile-editor"><view class="row"><button class="avatar-select" bindtap="avatar" disabled="{{profileSaving}}"><image wx:if="{{draftAvatar}}" src="{{draftAvatar}}" mode="aspectFill"/><text wx:else>＋ 头像</text></button><input value="{{draftName}}" bindinput="nameInput" maxlength="20" placeholder="输入你的昵称"/></view><button class="primary" bindtap="saveProfile" loading="{{profileSaving}}" disabled="{{profileSaving}}">保存个人资料</button></view>
  <button class="privacy-settings-entry" bindtap="privacySettings"><text>⚙</text><view><view>隐私设置</view><text>家园、宠物资料和笔记，统一管理</text></view><text>↗</text></button>
  <button class="visitor-preview-entry" bindtap="previewHomepage" disabled="{{loading}}"><text class="visitor-preview-icon">👀</text><view><view>访客视角预览</view><text>看看别人能看到哪些公开内容</text></view><text>↗</text></button>
  <view class="home-garden-card">
    <button class="garden-entry" bindtap="toggleGarden" aria-expanded="{{gardenOpen}}" aria-label="{{gardenOpen ? '收起我的家园' : '展开我的家园'}}"><view class="garden-entry-icon">🏡</view><view class="garden-entry-copy"><view>我的家园</view><text>去后院陪小伙伴玩一会儿</text></view><text class="garden-entry-action">{{gardenOpen ? '收起 ↑' : '展开 ↓'}}</text></button>
    <button class="garden-privacy-status" bindtap="gardenSettings"><text>{{gardenPrivacy === 'public' ? '✧ 家园已公开' : '🔒 家园仅自己可见'}}</text><text>隐私设置 ↗</text></button>
    <view wx:if="{{gardenOpen}}" class="backyard-panel"><backyard id="my-backyard" records="{{records}}" refreshing="{{loading}}"/></view>
  </view>
  <guestbook id="my-guestbook" user="{{profile.id || ''}}"/>
  <view class="archives-title">宠物档案 <text>每一位伙伴，都有一本自己的笔记</text></view>
  <view class="archive-filters"><button class="{{filter === 'all' ? 'chosen-filter' : ''}}" data-filter="all" bindtap="setFilter">全部 <text>{{records.length}}</text></button><button class="{{filter === 'alive' ? 'chosen-filter' : ''}}" data-filter="alive" bindtap="setFilter">现存 <text>{{aliveCount}}</text></button><button class="{{filter === 'departed' ? 'chosen-filter' : ''}}" data-filter="departed" bindtap="setFilter">已故 <text>{{departedCount}}</text></button></view>
  <view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点击重试</view>
  <view class="pet-rack">
    <view class="rack-heading"><view><view class="rack-title">宠物小精灵货架 <text>✦</text></view><text class="rack-subtitle">{{sorting ? '左右移动，笔记本也会一起排序' : '轻触精灵球，打开档案或管理状态'}}</text></view><button class="sort-toggle {{sorting ? 'sorting-on' : ''}}" bindtap="toggleSort" disabled="{{loading || mutating}}">{{sorting ? '完成排序 ✓' : '调整顺序 ⇄'}}</button></view>
    <scroll-view class="pet-rack-scroll" scroll-x="true"><view class="orb-track">
      <view wx:for="{{visible}}" wx:key="id" class="orb-item {{item.lifeStatus !== 'alive' ? 'orb-departed' : ''}}" data-id="{{item.id}}">
        <button class="pet-orb" data-id="{{item.id}}" bindtap="petActions" disabled="{{loading || mutating || sorting}}" aria-label="管理{{item.name}}的宠物档案"><view class="orb-gloss"></view><view class="orb-band"></view><view class="orb-avatar"><pet-avatar src="{{item.photoUrls[0] || item.photos[0] || ''}}" emoji="{{item.avatarEmoji}}" species="{{item.species}}"/></view><text class="orb-spark">✧</text></button>
        <view class="orb-name">{{item.name}}</view><view class="orb-status">{{item.lifeStatus === 'alive' ? '♡ 现存' : '☾ 已故'}}</view>
        <view wx:if="{{sorting}}" class="orb-sort"><button data-id="{{item.id}}" data-direction="-1" bindtap="movePet" disabled="{{index === 0 || mutating}}" aria-label="将{{item.name}}向左移动">←</button><text>{{index + 1}}</text><button data-id="{{item.id}}" data-direction="1" bindtap="movePet" disabled="{{index === visible.length - 1 || mutating}}" aria-label="将{{item.name}}向右移动">→</button></view>
      </view>
      <view wx:if="{{!visible.length}}" class="rack-empty"><text>◒</text><view>{{loading ? '正在整理小伙伴…' : !records.length ? '登记第一位伙伴，点亮一颗精灵球' : filter === 'alive' ? '现存货架暂时空着' : '这里珍藏着已故伙伴的回忆'}}</view></view>
    </view></scroll-view><view class="rack-plank"><view></view></view>
  </view>
  <view class="shared-filter-tip">两个架子共用上方筛选与顺序 · 全部包含现存和已故</view>
  <view class="single-bookshelf"><view class="shelf-caption"><text>✦ 小伙伴的笔记角落</text><text>{{loading ? '正在整理…' : '轻触封面，翻开记录'}}</text></view><view class="bookshelf-content"><view class="overview-corner" bindtap="overview" aria-role="button" aria-label="打开全体宠物总览笔记"><view class="overview-book"><keepsake name="全体伙伴" emoji="🐾" tone="sand" caption="总览记事本" locked="{{!overviewPublic}}"/></view><view class="book-label">总览笔记</view><text>记录大家的日常</text></view><scroll-view class="pet-books" scroll-x="true"><view class="books-track"><view wx:for="{{notebooks}}" wx:key="id" class="pet-notebook" data-id="{{item.id}}" bindtap="notebook" aria-role="button" aria-label="打开{{item.name}}的档案笔记"><view class="pet-book"><keepsake name="{{item.name}}" cover="{{item.photoUrls[0] || item.photos[0] || ''}}" emoji="{{item.avatarEmoji}}" species="{{item.species}}" tone="{{item.lifeStatus === 'alive' ? 'sage' : 'blue'}}" caption="{{item.lifeStatus === 'alive' ? '陪伴日记' : '珍藏回忆'}}" locked="{{item.notebookPrivacy !== 'public'}}"/></view><view class="book-label">{{item.name}}</view><text class="book-status">{{item.lifeStatus === 'alive' ? '♡ 现存' : '☾ 已故'}}{{item.no ? ' · ' + item.no : ''}}</text></view><view wx:if="{{!notebooks.length}}" class="empty-books"><view>📖</view><text>{{loading ? '正在打开档案…' : !records.length ? '第一本笔记，等你来写' : visible.length ? '在隐私设置中开启笔记本' : filter === 'alive' ? '还没有现存伙伴的档案' : '这里还没有已故伙伴的档案'}}</text></view></view></scroll-view></view><view class="single-plank"><view></view></view></view>
  <view class="shelf-tip">横向滑动翻看全部档案 · 总览笔记始终留在书架角落</view><button class="primary register-pet" bindtap="create">＋ 登记小伙伴</button><button class="homepage-link" bindtap="homepage">我的公开主页与宠物名片 <text>↗</text></button>
  <view class="shared-books-panel"><view class="shared-books-heading"><view><view>好友共写笔记 <text>♡</text></view><text>一起记录属于小伙伴的故事</text></view><button class="accept-invite-toggle" bindtap="toggleAcceptInvite">{{acceptingInvite ? '收起' : '接受邀请 ＋'}}</button></view><view wx:if="{{acceptingInvite}}" class="accept-invite-form"><input value="{{inviteInput}}" bindinput="invitationInput" maxlength="32" placeholder="粘贴好友发来的 32 位邀请码"/><button bindtap="openInvitation">查看邀请 →</button><text wx:if="{{!isCloud}}">当前是本机体验，启用微信云开发后可跨设备共写。</text></view><view wx:if="{{sharedError}}" class="shared-load-error" bindtap="loadShared">{{sharedError}} · 点击重试</view><button wx:for="{{sharedBooks}}" wx:key="bookId" class="shared-book-link" data-id="{{item.bookId}}" bindtap="openShared"><view class="shared-book-icon">{{item.privacy === 'public' ? '▤' : '🔒'}}</view><view><view>{{item.title}}</view><text>{{item.ownerName}} 邀请共写</text></view><text>↗</text></button><view wx:if="{{!sharedBooks.length && !sharedError}}" class="shared-books-empty">加入好友邀请后，共写笔记会收录在这里。<text>邀请入口在每本笔记内，单宠和总览都支持。</text></view></view>
  <inventory id="my-inventory" compact="{{true}}" wallet="{{wallet}}" loading="{{claiming}}" bindclaim="claim"/>
  <view class="private-note">🔒 私密笔记仅主人和受邀好友可见；公开笔记可供访客阅读。</view><button class="about" bindtap="about">关于档案与数据存储 ↗</button>
</view>
