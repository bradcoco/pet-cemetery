<view class="page create-page">
  <view class="eyebrow">A PLACE FOR YOUR FOREVER FRIEND</view>
  <view class="page-title serif">{{id ? '整理它的小小档案' : '你好，新的小伙伴。'}}</view>
  <view class="steps"><view class="{{step === 0 ? 'current' : ''}}"><text>01</text>认识伙伴</view><view class="{{step === 1 ? 'current' : ''}}"><text>02</text>宠物档案</view><view class="{{step === 2 ? 'current' : ''}}"><text>03</text>确认档案</view></view>
  <view wx:if="{{loading}}" class="empty">正在打开回忆…</view>
  <block wx:else>
    <view wx:if="{{hasDraft && !id && step === 0}}" class="draft row"><text>还有一份未完成的档案</text><button bindtap="restoreDraft">继续填写 ↗</button></view>
    <view wx:if="{{step === 0}}">
      <view class="section-heading serif">每一位伙伴，都值得被好好记录。</view><view class="description">陪在身边的日常，或永远珍藏的回忆，都可以从这里开始。</view>
      <view class="life-options"><button class="life-option {{form.lifeStatus === 'alive' ? 'chosen' : ''}}" data-value="alive" bindtap="life"><text>♡</text><view>正在身边陪伴</view><text>记录日常，也接住大家的喜欢</text></button><button class="life-option {{form.lifeStatus !== 'alive' ? 'chosen' : ''}}" data-value="departed" bindtap="life"><text>✧</text><view>已经成为星星</view><text>收藏回忆，让想念有处可归</text></button></view>
      <view wx:if="{{form.lifeStatus !== 'alive'}}" class="memorial-toggle row"><view><view>为它设立一座纪念碑</view><text>可先建立档案，之后再选择纪念位置</text></view><switch checked="{{form.hasMemorial}}" color="#69bea3" bindchange="memorialToggle" /></view>
      <block wx:if="{{form.hasMemorial}}"><view class="section-heading serif location-heading">我们把想念，安放在哪里？</view><view class="description">可以是一起散步的公园，也可以是你想带它去的远方。</view>
      <view wx:if="{{mapAvailable}}" class="map-box"><map id="location-map" class="location-map" latitude="{{form.latitude}}" longitude="{{form.longitude}}" scale="13" enable-scroll="true" enable-zoom="true" bindregionchange="mapEnd" bindtap="mapTap" binderror="mapError"><cover-view class="center-pin">✧</cover-view></map><view class="map-tip">拖动地图，让心意停在星光所在的位置</view></view>
      <view wx:else class="map-fallback"><text>⌖</text><view>为思念选择一个坐标</view><text class="description">当前端未启用地图，可以填写经纬度完成选址。</text></view>
      <button class="secondary search-location" bindtap="searchLocation">⌕ 搜索一个有回忆的地方</button>
      <view class="coordinate-row"><view><text class="field-label">纬度 LATITUDE</text><input type="text" maxlength="12" value="{{coordinateLat}}" data-field="coordinateLat" bindinput="coordinateInput" bindblur="applyCoordinates" /></view><view><text class="field-label">经度 LONGITUDE</text><input type="text" maxlength="12" value="{{coordinateLng}}" data-field="coordinateLng" bindinput="coordinateInput" bindblur="applyCoordinates" /></view></view>
      <view class="field"><view class="field-label">给这个地点起个名字 <text>*</text></view><input value="{{form.locationName}}" data-field="locationName" bindinput="input" placeholder="例如：和团团一起看日落的湖边" maxlength="60" /></view>
      <view class="gentle-note">✧ 这是线上纪念位置，不代表实体墓地或土地权益。</view></block><view wx:else class="gentle-note">♡ 不设立墓碑也可以拥有专属编号、纪念册和私密笔记。活着的伙伴设为公开后，朋友可以来主页送礼物。</view>
    </view>
    <view wx:elif="{{step === 1}}">
      <view class="section-heading serif">关于它的，都值得被记得。</view><view class="description">慢慢写，这里会好好收藏你们的故事。</view>
      <view class="field"><view class="field-label">它的名字 <text>*</text></view><input value="{{form.name}}" data-field="name" bindinput="input" maxlength="20" placeholder="那个你叫过无数次的名字" /></view>
      <view class="field"><view class="field-label">它是你的哪位小伙伴</view><view class="chips"><button wx:for="{{species}}" wx:key="*this" class="chip {{form.species === item ? 'chosen' : ''}}" data-field="species" data-value="{{item}}" bindtap="choose">{{item}}</button></view></view>
      <view class="field"><view class="field-label">宠物形象与笔记本封面</view><view class="pet-image-picker"><view class="pet-image-preview"><pet-avatar src="{{photoViews[0] || ''}}" emoji="{{form.avatarEmoji}}" species="{{form.species}}"/></view><view class="pet-image-actions"><button bindtap="openEmoji">🐾 选择动物 emoji</button><button bindtap="addPhotos" disabled="{{uploading || form.photos.length >= 9}}">＋ 上传照片</button></view></view><view class="avatar-hint">上传首张照片作为封面；没有照片时显示选择的动物形象。</view></view>
      <view class="field"><view class="field-label">品种 <text class="optional">选填</text></view><input value="{{form.breed}}" data-field="breed" bindinput="input" maxlength="30" placeholder="例如：橘猫、金毛，或独一无二的小可爱" /></view>
      <view class="coordinate-row dates"><view><view class="field-label">来到世界的日子 <text class="optional">选填</text></view><picker mode="date" end="{{today}}" value="{{form.birthday}}" data-field="birthday" bindchange="pickDate"><view class="date-value {{!form.birthday ? 'muted' : ''}}">{{form.birthday || '选择日期'}} <text>⌄</text></view></picker></view><view wx:if="{{form.lifeStatus !== 'alive'}}"><view class="field-label">成为星星的日子 <text>*</text></view><picker mode="date" end="{{today}}" value="{{form.departed}}" data-field="departed" bindchange="pickDate"><view class="date-value {{!form.departed ? 'muted' : ''}}">{{form.departed || '选择日期'}} <text>⌄</text></view></picker></view></view>
      <view wx:if="{{!form.hasMemorial}}" class="field"><view class="field-label">想对它说的一句话 <text class="optional">{{form.epitaph.length}} / 80</text></view><textarea class="short-text" value="{{form.epitaph}}" data-field="epitaph" bindinput="input" maxlength="80" placeholder="谢谢你，来过我的世界。" /></view>
      <view class="field"><view class="field-label">你们的故事 <text class="optional">{{form.story.length}} / 3000</text></view><textarea value="{{form.story}}" data-field="story" bindinput="input" maxlength="3000" placeholder="第一次遇见它，是怎样的一天？它有什么小习惯？你最想记住哪个瞬间？" /></view>
      <view class="field"><view class="field-label">那些闪闪发光的瞬间 <text class="optional">{{form.photos.length}} / 9 · 首张作为封面</text></view><view class="photos"><view wx:for="{{photoViews}}" wx:key="*this" class="photo-item"><image src="{{item}}" mode="aspectFill" /><button class="remove-photo" data-index="{{index}}" bindtap="removePhoto" aria-label="移除第{{index + 1}}张照片">×</button></view><button wx:if="{{form.photos.length < 9}}" class="photo-add" bindtap="addPhotos" disabled="{{uploading}}"><text>{{uploading ? '…' : '＋'}}</text><view>{{uploading ? '保存中' : '添加照片'}}</view></button></view></view>
    </view>
    <view wx:else>
      <view class="section-heading serif">选一种方式，把爱留下。</view><view class="description">{{id ? '外观在这里调整，可见范围前往统一隐私设置。' : '先选择初始可见范围，以后可在「隐私设置」统一调整。'}}</view>
      <block wx:if="{{form.hasMemorial}}"><view class="field-label">选择墓碑与地图标记样式</view><view class="stone-options"><button wx:for="{{stones}}" wx:key="id" class="stone-option {{form.stone === item.id ? 'chosen' : ''}}" data-field="stone" data-value="{{item.id}}" bindtap="choose"><view class="stone-art {{item.id}}"><image wx:if="{{markerView || photoViews[0]}}" src="{{markerView || photoViews[0]}}" mode="aspectFill"/><text wx:else>{{item.symbol}}</text><view>{{form.name || '它的名字'}}</view></view><view class="stone-name">{{item.name}}</view><text class="check">{{form.stone === item.id ? '✓' : '○'}}</text></button></view>
      <view class="marker-photo-controls"><button class="secondary upload-marker" bindtap="markerPhoto" disabled="{{uploading || saving}}">{{uploading ? '保存照片中…' : markerView ? '更换标记照片' : '＋ 上传标记照片'}}</button><button wx:if="{{markerView}}" class="clear-marker" bindtap="clearMarkerPhoto" disabled="{{uploading || saving}}">使用相册封面</button></view>
      <view class="marker-hint">标记照片独立保存；未单独上传时使用相册首张。仅照片样式需至少一张照片。</view>
      <view class="stone-live-preview"><view class="preview-label">墓碑实时预览 · 地图使用同款标记</view><memorial-stone pet="{{form}}" photo="{{markerView || photoViews[0] || ''}}"/><view class="preview-stone-links"><view><text>🐾 宠物档案</text><text>保存后可查看故事与相册 ↗</text></view><view><text>📖 宠物笔记</text><text>{{form.notebookEnabled === false ? '尚未开启笔记本' : form.memorialNotebook === false ? '主人暂未展示笔记入口' : form.notebookPrivacy === 'public' ? '阅读日常与回忆 ↗' : '🔒 仅主人与受邀好友可读'}}</text></view></view></view>
      <view class="field inscription-field"><view class="field-label">墓碑下方的镌刻文字 <text class="optional">{{form.epitaph.length}} / 80</text></view><textarea class="short-text" value="{{form.epitaph}}" data-field="epitaph" bindinput="input" maxlength="80" placeholder="谢谢你，来过我的世界。"/></view>
      <view class="memorial-notebook-setting row"><view><view>在墓碑下贴上宠物笔记</view><text>{{form.notebookEnabled === false ? '笔记本尚未开启，开启后才会展示入口' : '展示跳转入口；私密笔记只供主人与受邀好友查看'}}</text></view><switch class="memorial-notebook-switch" checked="{{form.memorialNotebook !== false}}" bindchange="memorialNotebookToggle" color="#69bea3" disabled="{{saving}}"/></view>
      </block>
      <block wx:if="{{!id}}">
      <view class="notebook-settings"><view class="notebook-option row"><view><view>同步创建宠物笔记本</view><text>为它建立整本笔记，展示在宠物档案书架上</text></view><switch class="notebook-enabled-switch" checked="{{form.notebookEnabled}}" bindchange="notebookToggle" color="#69bea3" disabled="{{saving}}"/></view><block wx:if="{{form.notebookEnabled}}"><view class="notebook-preview"><view><keepsake name="{{form.name}}" cover="{{photoViews[0] || ''}}" emoji="{{form.avatarEmoji}}" species="{{form.species}}" locked="{{form.notebookPrivacy !== 'public'}}"/></view><text>{{form.notebookPrivacy === 'public' ? '✧ 公开笔记 · 访客可以阅读' : '🔒 私密笔记 · 仅主人和受邀好友可见'}}</text></view><view class="notebook-option notebook-public-option row"><view><view>笔记本公开可见</view><text>{{form.notebookPrivacy === 'public' ? '全部已有和新记录均公开，含好友共写的内容；访客不能直接修改。' : '不对访客开放，封面显示 🔒，受邀共写好友仍可访问。'}}</text></view><switch class="notebook-public-switch" checked="{{form.notebookPrivacy === 'public'}}" bindchange="notebookPublicToggle" color="#69bea3" disabled="{{saving}}"/></view><view class="notebook-scope-tip">笔记本公开不等于宠物资料公开，两者独立设置。</view></block><view wx:else class="notebook-disabled-hint">本次不创建或展示笔记本。已有记录和共写成员会保留，重新开启后可继续使用。</view></view>
      <view class="field privacy"><view class="field-label">谁可以认识它</view><button class="privacy-option {{form.privacy === 'private' ? 'chosen' : ''}}" data-field="privacy" data-value="private" bindtap="choose"><text class="privacy-icon">☽</text><view><view>只属于我的星屿</view><text>仅自己可见，安静收藏日常和回忆</text></view><text>{{form.privacy === 'private' ? '●' : '○'}}</text></button><button class="privacy-option {{form.privacy === 'public' ? 'chosen' : ''}}" data-field="privacy" data-value="public" bindtap="choose"><text class="privacy-icon">✧</text><view><view>让爱被更多人看见</view><text>{{form.hasMemorial ? '名字、故事、照片和精确位置均公开' : '档案将在个人主页公开，活着的伙伴可以收到礼物'}}</text></view><text>{{form.privacy === 'public' ? '●' : '○'}}</text></button></view>
      </block>
      <view wx:else class="managed-privacy"><view>隐私设置已统一管理</view><text>宠物资料：{{form.privacy === 'public' ? '✧ 公开' : '🔒 私密'}}</text><text>笔记本：{{!form.notebookEnabled ? '已隐藏，记录保留' : form.notebookPrivacy === 'public' ? '✧ 公开可读' : '🔒 仅主人和受邀好友可见'}}</text><button bindtap="openPrivacy" disabled="{{saving || uploading}}">前往隐私设置 ↗</button></view>
      <view class="summary"><view class="serif">{{form.name}}的小小星屿</view><text wx:if="{{form.hasMemorial}}">⌖ {{form.locationName}}</text><view class="notebook-summary">{{!form.notebookEnabled ? '不创建宠物笔记本' : form.notebookPrivacy === 'public' ? '✧ 笔记本公开可读' : '🔒 笔记本私密可见'}}</view><view class="summary-quote">「{{form.epitaph || '谢谢你，来过我的世界。'}}」</view></view>
      <view wx:if="{{!isCloud}}" class="gentle-note">本机体验：纪念和照片只存于当前设备，清理数据或卸载可能丢失；公开设置尚不会向其他设备发布。</view>
    </view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="form-actions"><button wx:if="{{step > 0}}" class="secondary" bindtap="previous" disabled="{{saving}}">上一步</button><button wx:if="{{step < 2}}" class="primary" bindtap="next" disabled="{{uploading}}">下一步 <text>→</text></button><button wx:else class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || uploading}}">{{id ? '保存宠物档案' : '登记这位小伙伴'}} ✧</button></view>
  </block>
</view>

<view wx:if="{{registered}}" class="registration-mask">
  <view class="registration-light"></view><view class="registration-greeting serif">很高兴，在这里遇见你。</view>
  <view class="registration-perspective"><view class="registration-card"><view class="registration-card-frame"><view class="registration-card-top"><text>STELLAR PAWS</text><text>✧ PET IDENTITY</text></view><view class="registration-portrait"><pet-avatar src="{{registered.photoUrls[0] || registered.photos[0] || ''}}" emoji="{{registered.avatarEmoji}}" species="{{registered.species}}"/></view><view class="registration-name serif">{{registered.name}}</view><view class="registration-species">{{registered.breed || registered.species}} · {{registered.lifeStatus === 'alive' ? '正在好好长大' : '永远珍藏的伙伴'}}</view><view class="registration-divider"></view><view class="serial-label">{{isCloud ? 'EXCLUSIVE PET NUMBER' : 'LOCAL PET NUMBER'}}</view><view class="registration-no">{{registered.no}}</view><view class="registration-ordinal">{{isCloud ? '星屿' : '本机'}}第 {{registrationOrdinal}} 位被记录的伙伴</view><view class="registration-card-bottom"><text>从 000000 开始，每一位都独一无二</text><text>✦</text></view></view></view></view>
  <view class="registration-note">{{isCloud ? '这是它的专属顺序号，之后一直保留。' : '当前是本机体验编号；正式全平台顺序号由云端分配。'}}</view>
  <button class="registration-primary" bindtap="openRegistered">{{registered.hasMemorial ? '去看它的小小星屿' : registered.notebookEnabled === false ? '查看它的宠物档案' : '翻开它的时光笔记'}} →</button><button class="registration-secondary" bindtap="openCabinet">打开宠物档案</button>
</view>

<view wx:if="{{choosingEmoji}}" class="emoji-mask" bindtap="closeEmoji"><view class="emoji-sheet" catchtap="stopTap"><view class="emoji-heading"><view>选一位可爱的动物形象</view><button bindtap="closeEmoji" aria-label="关闭">×</button></view><view class="emoji-description">内置 emoji，无需上传照片也能拥有自己的形象。</view><view class="emoji-grid"><button wx:for="{{emojis}}" wx:key="emoji" class="{{form.avatarEmoji === item.emoji ? 'selected-emoji' : ''}}" data-emoji="{{item.emoji}}" bindtap="chooseEmoji" aria-label="选择{{item.emoji}}">{{item.emoji}}</button></view></view></view>
