<view wx:if="{{visitorPreview}}" class="visitor-preview-banner"><view><view>👀 正在预览普通访客视角</view><text>只展示公开内容，私密资料和库存不展示</text></view><button bindtap="cabinet">退出预览</button></view><view wx:if="{{visitorPreview}}" class="visitor-preview-spacer"></view>
<view wx:if="{{loading}}" class="page"><view class="empty">正在翻开它的时光笔记…</view></view>
<view wx:elif="{{error}}" class="page"><view class="empty"><view class="empty-title serif">这本回忆，暂时没有打开</view><view>{{error}}</view><button class="primary" bindtap="cabinet">回到宠物档案</button></view></view>
<view wx:elif="{{invitation}}" class="page invite-landing"><view class="invite-illustration">📖<text>♡</text></view><view class="eyebrow">LET’S WRITE TOGETHER</view><view class="page-title">一起写下它们的故事</view><view class="invite-from">{{invitation.ownerName}} 邀请你加入</view><view class="invite-book-title">{{invitation.title}}</view><view class="invite-explanation">加入后可以查看本内已有和新写的记录，新增文字与照片，并编辑自己的笔记。主人可以移除成员或删除记录。<br/>仅共享这一本，不开放其他私密档案。</view><button class="primary" bindtap="acceptInvite" loading="{{joining}}" disabled="{{joining}}">接受邀请，一起写 ✦</button><button class="invite-back" bindtap="cabinet">暂时不加入，返回我的档案</button></view>
<view wx:elif="{{overview || memorial}}" class="notebook-page">
  <view class="notebook-cover"><view class="cover-heading row"><text class="eyebrow">{{overview ? 'TOGETHER, IN ONE NOTEBOOK' : 'OUR LITTLE MEMORIES'}}</text><view class="cover-options"><text class="volume">{{overview ? 'OVERVIEW' : 'No. ' + volume}}</text><button wx:if="{{isOwner}}" class="notebook-settings" bindtap="openSettings">⚙ 笔记设置</button></view></view><view class="notebook-intro"><view class="cover-object"><keepsake name="{{overview ? '全体伙伴' : memorial.name}}" cover="{{!overview ? memorial.photoUrls[0] || memorial.photos[0] || '' : ''}}" emoji="{{overview ? '🐾' : memorial.avatarEmoji}}" species="{{overview ? '其他' : memorial.species}}" tone="{{overview ? 'sand' : 'sage'}}" caption="{{overview ? '总览记事本' : '档案笔记'}}" locked="{{privacy !== 'public'}}"/></view><view class="cover-text"><view class="eyebrow">{{overview ? '记录大家共同的日常' : '翻开属于你们的每一页'}}</view><view class="notebook-title serif">{{overview ? '全体伙伴' : memorial.name}}<view>{{overview ? '总览记事本' : '的时光笔记'}}</view></view><text>{{notes.length}} 页记录 · {{privacy === 'public' ? '✧ 公开可读' : memberCount ? '🔒 仅共写成员可见' : '🔒 仅自己可见'}}</text></view></view><view class="cover-bottom row"><text>{{overview ? '一起散步、吃饭、成长，写下大家的故事。' : '每一个小小瞬间，都值得认真收藏。'}}</text><button bindtap="memorial">{{visitorPreview ? '返回预览 ↗' : !isOwner || overview ? '返回我的档案 ↗' : '查看它的档案 ↗'}}</button></view></view>
  <view class="collaboration-card"><view class="collab-symbol">♡<text>✎</text></view><view class="collab-copy"><view>{{!canWrite ? '公开笔记 · 访客只读' : memberCount ? '和好友一起，把回忆写满' : '邀请好友一起写笔记'}}</view><text>{{!canWrite ? ownerName + '分享的记录，受邀后才可参与共写' : !isOwner ? ownerName + '的笔记本 · 可新增并编辑自己的记录' : memberCount ? memberCount + ' 位共写好友 · ' + (privacy === 'public' ? '公开阅读' : '仅成员可见') : privacy === 'public' ? '访客可阅读，邀请好友后才能一起记录' : '默认私藏，邀请后仅对加入的好友开放'}}</text></view><button wx:if="{{isOwner}}" class="collab-invite" bindtap="openSharing">{{memberCount ? '管理共写 ↗' : '邀请好友 ↗'}}</button></view>
  <scroll-view wx:if="{{overview && overviewPets.length}}" class="overview-pets" scroll-x="true"><view class="overview-pets-track"><view wx:for="{{overviewPets}}" wx:key="id" class="overview-pet" data-id="{{item.id}}" bindtap="openPet"><view class="overview-pet-avatar"><pet-avatar src="{{item.photoUrls[0] || item.photos[0] || ''}}" emoji="{{item.avatarEmoji}}" species="{{item.species}}"/></view><text>{{item.name}}</text></view></view></scroll-view>
  <view class="notebook-content"><view class="row journal-heading"><view><view class="eyebrow">LITTLE MOMENTS, FOREVER KEPT</view><view class="section-title serif">{{overview ? '写给大家的日子' : '写给它的日子'}}</view></view><button wx:if="{{canWrite}}" class="write-button" bindtap="newNote">＋ 写一页</button></view>
    <view class="note-search"><input value="{{query}}" bindinput="searchNotes" placeholder="搜索标题、内容或标签" maxlength="100" confirm-type="search"/><button wx:if="{{query || tagFilter}}" bindtap="clearFilters">清除</button></view>
    <scroll-view wx:if="{{tags.length}}" class="tag-filter-scroll" scroll-x="true"><view class="tag-filter-track"><button class="tag-chip {{!tagFilter ? 'tag-active' : ''}}" data-id="" bindtap="filterTag">全部</button><button wx:for="{{tags}}" wx:key="id" class="tag-chip {{tagFilter === item.id ? 'tag-active' : ''}}" data-id="{{item.id}}" bindtap="filterTag"># {{item.name}}</button></view></scroll-view>
    <view wx:if="{{notes.length}}" class="search-count">{{visibleNotes.length}} / {{notes.length}} 条记录</view>
    <view wx:if="{{notes.length && !visibleNotes.length}}" class="search-empty">没有找到匹配的记录<button bindtap="clearFilters">查看全部记录</button></view>
    <view wx:if="{{!notes.length}}" class="first-page"><view class="paper-corner"></view><text class="first-star">✧</text><view class="serif">{{!canWrite ? '这本笔记，还在等待第一段故事。' : overview ? '今天，大家有什么新故事？' : '第一句话，想对它说什么？'}}</view><text>一件小事，一张旧照片，或今天突然涌起的想念。<br/>{{privacy === 'public' ? '这里的记录，公开分享给每一位关心它的人。' : memberCount ? '和共写好友，一起留下回忆。' : '这里的笔记，只属于你。'}}</text><button wx:if="{{canWrite}}" class="primary" bindtap="newNote">写下第一页 →</button></view>
    <view wx:for="{{visibleNotes}}" wx:key="id" class="journal-entry"><view class="entry-date"><text class="date-dot"></text>{{item.date}}<text class="entry-index">{{visibleNotes.length - index < 10 ? '0' + (visibleNotes.length - index) : visibleNotes.length - index}} / MEMORY</text></view><view class="entry-paper"><view class="paper-corner"></view><view wx:if="{{item.title}}" class="entry-title serif">{{item.title}}</view><view wx:if="{{item.content}}" class="entry-content">{{item.content}}</view><view wx:if="{{item.photos.length}}" class="entry-photos"><image wx:for="{{item.photoUrls || item.photos}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" data-id="{{item.id}}" data-src="{{photo}}" bindtap="preview" /></view><view wx:if="{{item.tags.length}}" class="entry-tags"><button wx:for="{{item.tags}}" wx:for-item="tag" wx:key="id" data-id="{{tag.id}}" bindtap="filterTag"># {{tag.name}}</button></view><view class="entry-tools"><text>{{item.authorName || '我'}} · {{privacy === 'public' ? '✧ 公开的一页' : '🔒 私密的一页'}}</text><view><button wx:if="{{item.canEdit !== false}}" data-id="{{item.id}}" bindtap="editNote">编辑</button><button wx:if="{{item.canDelete !== false}}" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></view></view>
    <view class="notebook-footer serif">有些陪伴，从不因时间而褪色。<text>✧ FOREVER A PART OF YOU</text></view>
  </view>
</view>
<view wx:if="{{editing}}" class="note-mask" bindtap="closeEditor"><view class="note-editor" catchtap="stopTap"><view class="editor-head row"><view><view class="eyebrow">A PAGE FOR YOUR LITTLE FRIEND</view><view class="serif">{{noteId ? '再整理一次，这份记录。' : overview ? '今天，想记下大家的什么？' : '今天，也想和你说说话。'}}</view></view><button class="close-editor" bindtap="closeEditor" disabled="{{saving || uploading}}">×</button></view><scroll-view class="editor-scroll" scroll-y="true"><view class="editor-body"><view class="editor-date row"><text>记录在这一天</text><picker mode="date" value="{{form.date}}" end="{{today}}" bindchange="date"><view>{{form.date}} <text>⌄</text></view></picker></view><input class="note-title-input serif" value="{{form.title}}" data-field="title" bindinput="input" maxlength="60" placeholder="给这一页起个名字（选填）" /><textarea class="note-content-input" value="{{form.content}}" data-field="content" bindinput="input" maxlength="5000" placeholder="{{overview ? '今天大家一起在后院玩耍……记录共同的日常、照顾计划或成长故事。' : '今天翻到了你的旧照片……把想说的话，慢慢写下来。'}}" cursor-spacing="80" /><view class="word-count">{{form.content.length}} / 5000</view><view class="editor-tag-heading">给这次记录分类 <text>可多选 · 最多 10 个</text></view><view wx:if="{{editorTags.length}}" class="editor-tags"><button wx:for="{{editorTags}}" wx:key="id" class="tag-chip {{item.selected ? 'tag-active' : ''}}" data-id="{{item.id}}" bindtap="selectTag" disabled="{{saving || uploading}}">{{item.selected ? '✓ ' : '# '}}{{item.name}}</button></view><view wx:else class="editor-no-tags">{{isOwner ? '还没有标签，可先保存记录，再到笔记首页的「笔记设置」添加。' : '主人尚未添加标签，记录可以暂不分类。'}}</view><view class="photo-label row"><text>贴几张照片</text><text>{{form.photos.length}} / 9</text></view><view class="note-photos"><view wx:for="{{photoViews}}" wx:key="*this" class="note-photo"><image src="{{item}}" mode="aspectFill" /><button data-index="{{index}}" bindtap="removePhoto">×</button></view><button wx:if="{{form.photos.length < 9}}" class="add-photo" bindtap="addPhotos" disabled="{{uploading}}"><text>{{uploading ? '…' : '＋'}}</text><view>{{uploading ? '保存中' : '贴一张照片'}}</view></button></view><view wx:if="{{editorError}}" class="error">{{editorError}}</view><view class="private-note">☽ {{privacy === 'public' ? '这本笔记已设为公开，这一页保存后访客也能阅读。' : memberCount ? '🔒 这页仅笔记本主人和共写好友可见。' : '🔒 笔记仅自己可见。'}}<br/>暂时合上时，会在本机为你保留未完成的草稿。</view></view></scroll-view><view class="editor-actions"><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || uploading}}">把这一页，好好收藏 ✧</button></view></view></view>

<view wx:if="{{sharingOpen}}" class="note-mask" bindtap="closeSharing"><view class="sharing-panel" catchtap="stopTap"><view class="sharing-head row"><view><view class="eyebrow">WRITE OUR MEMORIES TOGETHER</view><view class="sharing-title">笔记设置</view></view><button class="close-editor" bindtap="closeSharing" disabled="{{sharingBusy || settingsBusy}}">×</button></view><view class="settings-tabs"><button class="{{settingsTab === 'general' ? 'settings-active' : ''}}" data-tab="general" bindtap="settingsTab" disabled="{{sharingBusy || settingsBusy}}">标签管理</button><button class="{{settingsTab === 'members' ? 'settings-active' : ''}}" data-tab="members" bindtap="settingsTab" disabled="{{sharingBusy || settingsBusy}}">成员设置 {{memberCount}}</button></view><scroll-view class="sharing-scroll" scroll-y="true"><view class="sharing-body"><view wx:if="{{settingsTab === 'general'}}" class="general-settings"><view class="privacy-setting"><view><view>{{privacy === 'public' ? '✧ 这本笔记公开可读' : '🔒 这本笔记仅主人和受邀好友可见'}}</view><text>公开范围已统一到个人主页的隐私设置。</text></view><button class="open-privacy-settings" bindtap="openPrivacy">前往隐私设置 ↗</button></view><view class="tag-manager-title">记录标签 <text>{{tags.length}} / 30</text></view><view class="settings-hint">先在这里创建分类，例如打疫苗、绝育、日常，再在写记录时选择；每次记录最多选 10 个。</view><view class="tag-create row"><input class="tag-name-input" value="{{tagName}}" bindinput="tagNameInput" placeholder="输入新标签，例如打疫苗" maxlength="20" disabled="{{settingsBusy}}"/><button class="add-tag" bindtap="addTag" loading="{{settingsBusy}}" disabled="{{settingsBusy || tags.length >= 30}}">＋ 添加</button></view><view class="managed-tags"><view wx:for="{{tags}}" wx:key="id" class="managed-tag"><text># {{item.name}}</text><button data-id="{{item.id}}" bindtap="deleteTag" disabled="{{settingsBusy}}" aria-label="删除{{item.name}}标签">×</button></view></view><view wx:if="{{!tags.length}}" class="no-tags">还没有标签，添加第一个分类吧。</view><view class="settings-hint">删除标签会移除已有记录的这个分类，记录内容和照片保留。</view><view wx:if="{{settingsError}}" class="error">{{settingsError}}</view></view><block wx:else><view class="sharing-description">好友加入后可查看这本笔记的全部已有和新写的记录，新增文字、照片，并修改自己的记录。主人可管理成员、删除任何记录；其他档案仍然私密。</view><view wx:if="{{!isCloud}}" class="cloud-required"><view>☁ 当前是本机体验</view><text>跨设备共同编辑需要启用微信云开发账户。当前设备上的笔记仍可正常书写；启用云端后即可生成邀请码、邀请好友。App 端暂未接入共享账户。</text></view><block wx:else><view wx:if="{{sharing.code}}" class="invite-code-card"><text>专属邀请码 · {{expiresLabel}} 到期</text><view class="invite-code">{{sharing.code}}</view><view class="invite-code-actions"><button bindtap="copyInvite">复制邀请码</button><button wx:if="{{!native}}" data-share="invite" open-type="share">分享给微信好友 ↗</button></view><text>持有邀请码的好友可主动加入，最多 20 人。</text><button class="stop-invite" bindtap="stopInvite" disabled="{{sharingBusy}}">停止当前邀请</button></view><view wx:else class="create-invite"><text>邀请码 7 天有效，可随时停止新加入。已加入好友的权限需单独移除。</text><button class="primary" bindtap="createInvite" loading="{{sharingBusy}}" disabled="{{sharingBusy}}">生成 7 天邀请码 ✦</button></view><view class="members-title">共写好友 <text>{{sharing.members.length}} / 20</text></view><view wx:if="{{!sharing.members.length}}" class="no-members">还没有好友加入，一起写下第一个故事吧。</view><view wx:for="{{sharing.members}}" wx:key="id" class="sharing-member row"><view class="member-avatar">✎</view><text>{{item.name}}</text><button data-id="{{item.id}}" bindtap="removeMember" disabled="{{sharingBusy}}">移除</button></view></block><view wx:if="{{sharingError}}" class="error">{{sharingError}}<button wx:if="{{isCloud}}" bindtap="refreshSharing">重新读取</button></view><view class="sharing-footnote">停止邀请码不会移除现有好友；移除好友也不会删除对方已经写下的记录。</view></block></view></scroll-view></view></view>
