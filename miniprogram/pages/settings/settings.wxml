<view class="page privacy-settings-page">
  <view class="settings-heading"><view class="eyebrow">YOUR WORLD, YOUR CHOICE</view><view class="settings-title">隐私设置</view><view class="settings-description">谁能看到哪些内容，在这里一起管理。</view></view>
  <view class="privacy-overview"><view><text>{{publicPets}}</text> 位公开伙伴 · <text>{{publicBooks}}</text> 本公开宠物笔记</view><text>开关修改后立即保存，已有记录和家园摆放会保留。</text><button class="preview-privacy" bindtap="preview" disabled="{{loading || busy || error}}">👀 看看普通访客会看到什么 ↗</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新读取设置</button></view>
  <view wx:if="{{loading}}" class="settings-loading">正在读取你的隐私设置…</view>
  <view id="garden-settings" class="privacy-card"><view class="privacy-card-heading">🏡 家园</view><view class="setting-row"><view><view>公开到主页</view><text>{{gardenPrivacy === 'public' ? '✧ 访客可查看后院和公开摆放的伙伴' : '🔒 家园仅自己可见'}}</text></view><switch class="garden-privacy-switch" checked="{{gardenPrivacy === 'public'}}" data-field="garden" bindchange="globalChange" color="#80b89b" disabled="{{loading || busy || error}}"/></view><view class="settings-explanation">家园公开时只展示资料已公开的宠物。私密伙伴留在自己的后院，访客不能改动摆放。</view></view>
  <view id="overview-settings" class="privacy-card"><view class="privacy-card-heading">📖 全体伙伴总览笔记</view><view class="setting-row"><view><view>公开可见</view><text>{{overviewPrivacy === 'public' ? '✧ 全部历史与新记录可被访客阅读' : '🔒 仅自己和受邀共写好友可见'}}</text></view><switch class="overview-privacy-switch" checked="{{overviewPrivacy === 'public'}}" data-field="overview" bindchange="globalChange" color="#80b89b" disabled="{{loading || busy || error}}"/></view><button class="manage-members" data-id="__overview__" bindtap="members" disabled="{{loading || busy || error}}">共写成员与邀请 <text>↗</text></button></view>
  <view class="pet-settings-heading">🐾 每位伙伴的资料与笔记</view><view class="settings-explanation pet-scope-description">资料公开会展示照片、故事和设碑时的精确位置。笔记公开范围独立设置，公开后访客可以阅读全部记录，包括好友共写内容。</view>
  <view wx:if="{{!loading && !error && !records.length}}" class="empty">登记小伙伴后，就能在这里统一设置。</view>
  <view wx:for="{{records}}" wx:key="id" id="privacy-pet-{{item.id}}" class="privacy-card pet-privacy-card {{focusId === item.id ? 'focused-pet' : ''}}" data-id="{{item.id}}"><view class="pet-settings-intro"><view class="settings-pet-avatar"><pet-avatar src="{{item.photoUrls[0] || item.photos[0] || ''}}" emoji="{{item.avatarEmoji}}" species="{{item.species}}"/></view><view><view>{{item.name}}</view><text>{{item.lifeStatus === 'alive' ? '♡ 现存' : '☾ 已故'}}{{item.no ? ' · No. ' + item.no : ''}}</text></view></view>
    <view class="setting-row"><view><view>宠物资料公开</view><text>{{item.privacy === 'public' ? '✧ 访客能在主页认识它' : '🔒 仅自己可见'}}</text></view><switch class="pet-profile-switch" checked="{{item.privacy === 'public'}}" data-id="{{item.id}}" data-field="privacy" bindchange="petChange" color="#80b89b" disabled="{{loading || busy || error}}"/></view>
    <view class="setting-row"><view><view>创建并展示笔记本</view><text>{{item.notebookEnabled === false ? '已隐藏，原有记录与成员保留' : '在档案书架展示整本笔记'}}</text></view><switch class="pet-notebook-switch" checked="{{item.notebookEnabled !== false}}" data-id="{{item.id}}" data-field="notebookEnabled" bindchange="petChange" color="#80b89b" disabled="{{loading || busy || error}}"/></view>
    <view class="setting-row"><view><view>笔记公开可见</view><text>{{item.notebookEnabled === false ? '重新开启笔记时，沿用原公开范围' : item.notebookPrivacy === 'public' ? '✧ 访客可阅读，写入仍需邀请' : '🔒 仅自己和受邀共写好友可见'}}</text></view><switch class="pet-notebook-public-switch" checked="{{item.notebookPrivacy === 'public'}}" data-id="{{item.id}}" data-field="notebookPrivacy" bindchange="petChange" color="#80b89b" disabled="{{loading || busy || error || item.notebookEnabled === false}}"/></view>
    <button wx:if="{{item.notebookEnabled !== false}}" class="manage-members" data-id="{{item.id}}" bindtap="members" disabled="{{loading || busy || error}}">共写成员与邀请 <text>↗</text></button>
  </view>
  <view class="fixed-privacy"><view>始终按这些规则展示</view><text>🔒 物品库存只对自己可见。</text><text>👤 昵称和头像用于公开主页及留言名片。</text><text>✎ 留言板内容公开，作者和主页主人可以删除。</text></view>
  <view wx:if="{{!isCloud}}" class="settings-local-note">本机体验：设置保存在当前设备，公开内容不会发布到其他设备。跨设备探访与共写需启用云端账户。</view>
  <view class="settings-saving">{{busy ? '正在保存这一项…' : '每一份陪伴，都按你的心意分享。'}}</view>
</view>
