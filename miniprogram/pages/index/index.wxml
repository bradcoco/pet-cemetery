<view class="home">
  <view class="home-heading"><view class="home-brand"><text class="brand-icon">✦</text><text>星屿</text><text class="brand-subtitle">小伙伴的世界</text></view><view class="map-status"><text></text>{{isCloud ? '一起看世界' : '我的小世界'}}</view></view>
  <view class="map-card">
    <view class="map-toolbar"><view class="province-title">⌖ {{provinceName}}{{!provinceCode ? '省份地图' : ''}}</view><button wx:if="{{provinceCode}}" class="back-national" bindtap="national">← 返回</button></view>
    <view class="map-subtitle"><text>{{provinceCode ? provincePets.length + ' 只小伙伴在这里' : '放大地图，点击想去的省份'}}</text><text wx:if="{{examples}}" class="example-tag">含示例点位</text></view>
    <view class="world">
      <china-map id="province-overview" wx:if="{{!provinceCode || !mapAvailable}}" province="{{provinceCode}}" pets="{{provincePets}}" bindprovincechange="provinceTap" bindpettap="petTap" />
      <map wx:else id="pet-map" class="map" longitude="{{mapLng}}" latitude="{{mapLat}}" scale="{{scale}}" markers="{{markers}}" polygons="{{polygons}}" enable-scroll="{{true}}" enable-zoom="{{true}}" bindmarkertap="markerTap" bindcallouttap="markerTap" binderror="mapError" />
    </view>
    <view class="map-bottom"><view wx:if="{{provinceCode}}" class="species-legend"><text>🐱 猫咪</text><text>🐶 狗狗</text><text>🐰 兔兔</text><text>🐦 鸟儿</text><text>🐾 其他</text></view><view class="map-hint">{{!provinceCode ? '双指放大 · 拖动查看 · 点击省份进入' : provincePets.length ? '双指缩放地图 · 点击宠物标记探访' : '这里还没有公开的宠物点位'}}</view></view>
  </view>
  <view wx:if="{{error}}" class="home-error" bindtap="load">{{error}} · 点击重试</view>
</view>
<view wx:if="{{pointPets.length}}" class="point-mask" bindtap="closePoint"><view class="point-sheet" catchtap="stopTap"><view class="point-heading"><text>这个坐标的小伙伴</text><button bindtap="closePoint" aria-label="关闭">×</button></view><scroll-view class="point-scroll" scroll-y="true"><button wx:for="{{pointPets}}" wx:key="id" class="point-pet" data-id="{{item.id}}" bindtap="pointPet"><image src="{{item.photoUrls[0] || item.photos[0] || '/assets/pet.png'}}" mode="aspectFill"/><view><view>{{item.name}}</view><text>{{item.species}}{{item.no ? ' · No. ' + item.no : ''}}</text></view><text>去看望 ↗</text></button></scroll-view></view></view>

<canvas type="2d" id="marker-canvas" class="marker-canvas"/>
