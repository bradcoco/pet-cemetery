<view class="guestbook">
  <view class="board-heading"><view class="board-symbol">✎</view><view><view class="board-title">留言板</view><text>把喜欢和惦念，留在这里</text></view></view>
  <view wx:if="{{visitorPreview}}" class="board-preview-note">访客可在这里留言，当前预览仅供查看。</view>
  <view wx:else class="board-composer"><textarea class="board-input" value="{{content}}" bindinput="input" maxlength="300" placeholder="留下一句温柔的话吧…" disabled="{{posting}}" cursor-spacing="70"/><view class="composer-actions"><text>{{content.length}} / 300 · 公开留言</text><button class="post-message" bindtap="post" loading="{{posting}}" disabled="{{posting || loading || !user}}">留下留言 ♡</button></view><view wx:if="{{!isCloud}}" class="board-local-note">本机体验：留言保存在当前设备；启用云端后可与其他用户互相留言。</view><view wx:if="{{editorError}}" class="board-error">{{editorError}}</view></view>
  <view wx:if="{{loading && !messages.length}}" class="board-empty">正在读大家的留言…</view>
  <view wx:elif="{{!messages.length && !error}}" class="board-empty">还没有留言，第一份心意等你留下。</view>
  <view wx:for="{{messages}}" wx:key="id" class="board-message" data-id="{{item.id}}" bindtap="showAuthor" aria-role="button" aria-label="查看留言者{{item.author.nickName}}的名片"><view class="message-heading"><text>{{item.author.nickName}}</text><text>{{item.dateLabel}}</text></view><view class="message-content">{{item.content}}</view><view class="message-bottom"><text>轻触留言，认识这位守护者 ↗</text><button wx:if="{{item.canDelete && !visitorPreview}}" data-id="{{item.id}}" catchtap="remove" disabled="{{deleting || posting}}">{{deleting === item.id ? '删除中…' : '删除'}}</button></view></view>
  <view wx:if="{{error}}" class="board-error">{{error}}<button bindtap="retry" disabled="{{loading}}">重新读取</button></view>
  <button wx:if="{{nextOffset !== null}}" class="more-messages" bindtap="more" disabled="{{loading}}">{{loading ? '正在读取…' : '查看更多留言 ↓'}}</button>
</view>
<view wx:if="{{author}}" class="author-mask" bindtap="closeAuthor"><view class="author-card" catchtap="stopTap"><button class="close-author" bindtap="closeAuthor" aria-label="关闭留言者名片">×</button><view class="author-avatar"><image src="{{author.avatarUrl || '/assets/default-avatar.jpg'}}" mode="aspectFill"/></view><view class="author-name">{{author.nickName}}</view><view class="author-hint">来认识这位守护者和小伙伴们</view><button class="author-home" bindtap="authorHome">进入用户主页 ↗</button></view></view>
