<view class="inventory {{compact ? 'compact' : ''}}">
  <view class="inventory-heading"><view><text class="inventory-title">{{compact ? '我的物品库存' : '每日签到与库存'}}</text><text wx:if="{{!compact}}" class="inventory-caption">连续签到得积分，积分可以换物品</text></view><button class="claim {{claimed ? 'claimed' : ''}}" bindtap="claim" loading="{{loading}}" disabled="{{claimed || loading}}">{{claimed ? '✓ 今日已签到' : '✧ 签到领积分'}}</button></view>
  <view wx:if="{{compact && owned.length}}" class="owned-row"><view class="owned-chip" wx:for="{{owned}}" wx:key="id"><text>{{item.icon}}</text><text>*{{item.balance}}</text></view></view>
  <view wx:if="{{compact}}" class="compact-summary"><text>{{points}} 积分</text><text>连续 {{streak}} 天 · {{rewardText}}</text></view>
  <block wx:else>
    <view class="inventory-value"><text>可用积分</text><text>{{points}} <text>分</text></text></view>
    <view class="checkin-status"><view><text>✦</text> {{claimed ? '已连续签到' : '连续签到第'}} <text>{{streak}}</text> 天</view><text>{{rewardText}}</text></view>
  </block>
  <view class="inventory-items"><view wx:for="{{items}}" wx:key="id" class="inventory-item {{compact && points < item.points ? 'short' : ''}}" data-kind="{{item.id}}" bindtap="exchange"><text class="item-icon {{item.id}}">{{item.icon}}</text><view class="item-name">{{item.name}}</view><text wx:if="{{!compact}}" class="item-points">{{item.points}} 分 / {{item.unit}}</text><text wx:if="{{!compact}}" class="item-balance">{{item.balance}} {{item.unit}}</text><text wx:if="{{compact}}" class="item-cost">{{item.points}}分</text><button wx:if="{{!compact}}" class="exchange {{points < item.points ? 'short' : ''}}" data-kind="{{item.id}}" catchtap="exchange" disabled="{{loading || points < item.points}}">{{points < item.points ? item.points + '分' : '兑换'}}</button></view></view>
  <view wx:if="{{!compact}}" class="reward-note">第一天 30 积分，之后每连续签到一天再加 10。中断后从 30 重新开始。<text>积分可兑换物品，赠送仍消耗库存。北京时间 00:00 更新。</text></view>
</view>
