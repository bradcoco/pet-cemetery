<view class="garden-shell {{!active || opened ? 'paused' : ''}}">
  <view class="garden-heading"><view><view class="garden-title">我们的后院 <text>HOME, SWEET HOME</text></view><view class="garden-description">{{loading ? '正在打开家园…' : '陪伴的日常，和被珍藏的想念。'}}</view></view><view class="weather">☀ 晴天</view></view>
  <view class="yard-scene {{placing ? 'is-placing' : ''}}" bindtap="sceneTap">
    <view class="sun"></view><view class="cloud cloud-one"></view><view class="cloud cloud-two"></view><view class="distant-bush bush-one"></view><view class="distant-bush bush-two"></view><view class="fence"><view class="fence-rail"></view></view>
    <view class="house"><view class="chimney"></view><view class="roof"></view><view class="house-wall"><view class="window window-left"><view></view></view><view class="window window-right"><view></view></view><view class="door"><view class="door-window"></view><view class="door-knob"></view></view><view class="house-sign">HOME ♡</view></view><view class="house-step"></view></view>
    <view class="tree tree-left"><view class="trunk"></view><view class="canopy canopy-one"></view><view class="canopy canopy-two"></view><view class="canopy canopy-three"></view><view class="fruit"></view></view><view class="tree tree-right"><view class="trunk"></view><view class="canopy canopy-one"></view><view class="canopy canopy-two"></view><view class="canopy canopy-three"></view></view>
    <view class="lawn"></view><view class="stone-path"><view></view><view></view><view></view><view></view></view><view class="lawn-patch patch-one"></view><view class="lawn-patch patch-two"></view><view class="grass grass-one">⌁</view><view class="grass grass-two">⌁</view><view class="grass grass-three">⌁</view><view class="flower flower-one">✿</view><view class="flower flower-two">✿</view><view class="flower flower-three">✿</view><view class="flower flower-four">✿</view><view class="butterfly"><view></view><view></view></view>
    <view class="memorial-zone" catchtap="stopTap"><view class="memorial-label"><text>☾ 星星纪念花园</text><button wx:if="{{!readOnly}}" class="memorial-add" data-tab="departed" bindtap="openWarehouse" aria-label="安放离世伙伴">＋</button></view><scroll-view wx:if="{{graves.length}}" class="grave-scroll" scroll-x="true"><view class="grave-list"><view wx:for="{{graves}}" wx:key="id" class="grave-plot" data-id="{{item.id}}" bindtap="graveTap" aria-role="button" aria-label="看望{{item.name}}"><memorial-stone pet="{{item}}" photo="{{item.markerPhotoUrl || item.markerPhoto || item.photoUrls[0] || item.photos[0] || ''}}" compact="{{true}}"/><view class="grave-flowers">✿ ❀</view></view></view></scroll-view><view wx:else class="memorial-empty" data-tab="departed" bindtap="openWarehouse"><text>❀</text><view>给想念，留一处花开的地方</view></view></view>
    <view wx:if="{{placing}}" class="place-area"></view><view wx:if="{{placing}}" class="place-guide">轻点草坪，放下{{placing.name}} ↓</view>
    <view class="water-bowl"><view></view><text>♡</text></view><view class="toy-ball" catchtap="ballTap" aria-role="button" aria-label="和小伙伴玩球"><view></view></view><view class="yard-sign">PAWS · PLAY</view>
    <view wx:for="{{actors}}" wx:key="id" class="yard-pet" style="left:{{item.x}}%;top:{{item.y}}%;z-index:{{index + 10}};" data-id="{{item.id}}" catchtap="petTap" aria-role="button" aria-label="和{{item.name}}互动"><view wx:if="{{bubbleId === item.id}}" class="pet-bubble">{{bubble}}</view><view class="pet-art"><pet-sprite species="{{item.species}}" emoji="{{item.avatarEmoji}}" walking="{{item.walking}}" happy="{{item.happy}}" facing="{{item.facing}}" paused="{{!active || opened || placing}}" /></view><view class="pet-name {{selected === item.id ? 'selected-name' : ''}}">{{item.name}}<text wx:if="{{selected === item.id}}"> ♡</text></view></view>
    <view wx:if="{{!actors.length && !placing && !loading}}" class="yard-welcome"><text>今天想和谁一起晒太阳？</text><view>{{readOnly ? '这里还没有公开摆放的小伙伴' : '从宠物仓，接一位小伙伴来玩吧'}}</view></view>
  </view>
  <view class="garden-controls">
    <block wx:if="{{readOnly}}"><view class="garden-summary"><text>{{actors.length}} 只在院子玩耍 · {{graves.length}} 份想念</text></view><view class="public-garden-note">✧ 轻触伙伴或墓碑，查看公开档案<text>这里是主人的后院，摆放由主人打理</text></view></block>
    <block wx:elif="{{placing}}"><view class="placing-title">正在放置：{{placing.name}}</view><button class="cancel-place" bindtap="cancelPlace" disabled="{{saving}}">{{saving ? '正在保存…' : '取消放置'}}</button></block>
    <block wx:elif="{{selected}}"><view class="selected-heading"><view>{{selectedName}}的快乐时光</view><button bindtap="petProfile">查看档案 ↗</button></view><view class="pet-actions"><button data-action="pet" bindtap="petAction">♡ 摸摸</button><button data-action="play" bindtap="petAction">⚽ 陪玩</button><button bindtap="movePet" disabled="{{saving}}">⌖ 挪位置</button><button bindtap="putBack" disabled="{{saving}}">↩ 收回</button></view></block>
    <block wx:else><view class="garden-summary"><text>{{actors.length}} 只在院子玩耍 · {{graves.length}} 份想念</text><text>点击伙伴和它互动</text></view><button class="warehouse-button" data-tab="all" bindtap="openWarehouse" disabled="{{loading || saving || refreshing}}"><view class="warehouse-icon">▤</view><view>打开宠物仓<text>把小伙伴接到后院来</text></view><text>＋</text></button></block>
    <view wx:if="{{error}}" class="garden-error" bindtap="rebuild">{{error}} · 点击重试</view>
  </view>
</view>
<view wx:if="{{opened && !readOnly}}" class="warehouse-mask" bindtap="closeWarehouse"><view class="warehouse-sheet" catchtap="stopTap"><view class="warehouse-heading"><view><view>我的宠物仓</view><text>属于你的小伙伴，都在这里等你。</text></view><button bindtap="closeWarehouse" aria-label="关闭宠物仓">×</button></view><view class="warehouse-tabs"><button class="{{tab === 'all' ? 'active-tab' : ''}}" data-tab="all" bindtap="warehouseTab">全部</button><button class="{{tab === 'alive' ? 'active-tab' : ''}}" data-tab="alive" bindtap="warehouseTab">现存</button><button class="{{tab === 'departed' ? 'active-tab' : ''}}" data-tab="departed" bindtap="warehouseTab">已故</button></view><scroll-view class="warehouse-scroll" scroll-y="true"><view wx:for="{{warehouse}}" wx:key="id" class="warehouse-row"><view class="warehouse-pet"><pet-sprite species="{{item.species}}" emoji="{{item.avatarEmoji}}" paused="{{true}}" /></view><view class="warehouse-information"><view>{{item.name}}</view><text>{{item.no ? 'No. ' + item.no + ' · ' : ''}}{{item.placed ? item.lifeStatus === 'alive' ? '正在后院玩耍' : '已在纪念花园' : item.lifeStatus === 'alive' ? item.species + ' · 现存' : item.species + ' · 已故'}}</text></view><button wx:if="{{item.placed}}" class="put-back" data-id="{{item.id}}" bindtap="returnPet" disabled="{{saving}}">收回</button><button wx:else class="take-out" data-id="{{item.id}}" bindtap="takeOut" disabled="{{saving}}">{{item.lifeStatus === 'alive' ? '取出放置' : '安放墓区'}}</button></view><view wx:if="{{!warehouse.length}}" class="warehouse-empty"><view>{{tab === 'all' ? '还没有登记小伙伴' : tab === 'alive' ? '还没有现存伙伴的档案' : '这里还没有已故伙伴的档案'}}</view><text>{{tab === 'alive' ? '先建立宠物档案，就能接它到后院玩耍。' : '离世伙伴登记后，可以在后院的纪念花园安放。'}}</text><button bindtap="createPet">＋ 登记一位伙伴</button></view></scroll-view><view class="warehouse-note">收回只会改变家园摆放，宠物档案和纪念记录会保留。</view></view></view>
