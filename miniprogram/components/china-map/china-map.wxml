<view class="china-map"><view class="canvas-area"><canvas wx:if="{{!failed}}" type="2d" id="china" class="canvas" disable-scroll="true" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" binderror="canvasError" aria-label="可放大的中国省份地图，拖动查看，点击真实省份区域进入具体地图" /><view wx:else class="map-error"><view>地图暂时没有加载出来</view><button bindtap="retry">重新加载地图 ↻</button></view></view><view wx:if="{{!failed && tools}}" class="map-tools"><button class="reset" bindtap="reset" aria-label="恢复地图全貌">⤢ 全图</button><view class="zoom-tools"><button bindtap="zoomOut" disabled="{{currentZoom <= 1}}" aria-label="缩小中国地图">−</button><view>{{zoomLabel}}×</view><button bindtap="zoomIn" disabled="{{currentZoom >= 5}}" aria-label="放大中国地图">＋</button></view></view></view>
