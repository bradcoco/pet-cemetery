<view class="gift-mask" bindtap="close"><view class="gift-sheet" catchtap="stopTap"><view class="gift-header"><view><text class="eyebrow">A LITTLE GIFT, A LOT OF LOVE</text><view class="gift-title">给{{pet.name}}的一份{{pet.lifeStatus === 'alive' ? '喜欢' : '想念'}}</view></view><button class="close" bindtap="close">×</button></view><view class="gift-description">{{pet.lifeStatus === 'alive' ? '小小的礼物，替你说一句“好喜欢你”。' : '选一份纪念心意，愿它在星星上被温柔惦记。'}}</view><view wx:if="{{loading}}" class="gift-loading">正在打开你的礼物盒…</view><scroll-view wx:else class="gift-items-scroll" scroll-y="true"><view class="gift-items"><button wx:for="{{items}}" wx:key="id" class="gift-item {{selected === item.id ? 'selected' : ''}}" data-kind="{{item.id}}" bindtap="select"><text class="gift-icon">{{item.icon}}</text><view>{{item.name}}</view><text class="gift-points">{{item.points}} 积分 / {{item.unit}}</text><text class="gift-balance">剩余 {{item.balance}} {{item.unit}}</text><text class="gift-check">{{selected === item.id ? '✓' : '○'}}</text></button></view></scroll-view><view class="daily-claim"><text>{{claimed ? '已连续签到 ' + streak + ' 天' : '连续签到第 ' + streak + ' 天'}}<text class="gift-checkin-reward">{{rewardText}}</text></text><button wx:if="{{!claimed}}" bindtap="claim" loading="{{claiming}}" disabled="{{claiming || sending}}">签到领积分 ↗</button></view><view wx:if="{{error}}" class="gift-error">{{error}}</view><button class="give-button" bindtap="give" loading="{{sending}}" disabled="{{loading || sending || claiming || !items.length}}">赠送一份心意 ✧</button><view class="gift-note">每次赠送消耗 1 件库存。积分可在物品库存里兑换这些礼物。</view></view></view>
